{
  "name": "offgrid",
  "version": "0.0.1",
  "author": "OffGrid",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --configuration=ci --watch=false",
    "lint": "ng lint",
    "check": "npm run lint && npm run test:ci && npm run build",
    "docs:install": "python3 -m venv .venv-docs && .venv-docs/bin/pip install -r requirements-docs.txt",
    "docs:build": ".venv-docs/bin/mkdocs build --strict",
    "docs:serve": ".venv-docs/bin/mkdocs serve -a 0.0.0.0:8000",
    "docs:screens": "node tools/screens.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@ionic/angular": "^9.0.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@capacitor/cli": "8.5.3",
    "@ionic/angular-toolkit": "^13.0.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "~5.0.5"
  },
  "description": "An Ionic project"
}
